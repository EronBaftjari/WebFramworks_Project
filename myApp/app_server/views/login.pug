doctype html
// design based on https://uicookies.com/free-login-forms/
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Sign in &mdash; Music App
    link(rel='stylesheet' href='/stylesheets/glass.css')
  body
    .blob.b1
    .blob.b2
    .blob.b3
    form.glass(action='/login' method='post')
      h1 Sign in
      p.sub Welcome back &mdash; Sign in to Listen to Music.

      //- error message from the API
      if message
        p.sub= message

      label(for='email') Email
      input#email(type='email' name='email' placeholder='you@example.com' autocomplete='email' required='')
      label(for='pw') Password
      input#pw(type='password' name='password' placeholder='Your password' autocomplete='current-password' required='')

      button(type='submit') Sign In

      p.alt
        | First time here? 
        a(href='/register') Create an account