doctype html
head
  meta(charset='UTF-8')
  meta(name='viewport' content='width=device-width, initial-scale=1, viewport-fit=cover')
  title Listening Archives &mdash; Aether
  style.
    :root{
    --bg:#0a0710; --panel:#140f1f; --panel-2:#181222; --border:#2a2338;
    --text:#f1eef7; --muted:#8b84a0; --accent:#a855f7; --accent-2:#22d3ee; --green:#34d399;
    padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{margin:0;background:var(--bg);color:var(--text);font-family:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:14px}
    a{color:inherit;text-decoration:none}
    .app{display:flex;min-height:100vh}
    /* Sidebar */
    .side{width:220px;flex:none;background:var(--panel);border-right:1px solid var(--border);padding:22px 16px;display:flex;flex-direction:column;gap:26px}
    .brand{display:flex;align-items:center;gap:9px;font-weight:600;font-size:15px;letter-spacing:.02em;padding:0 6px}
    .brand .mark{width:26px;height:26px;border-radius:7px;background:linear-gradient(135deg,var(--accent),var(--accent-2));display:flex;align-items:center;justify-content:center;font-size:13px}
    nav{display:flex;flex-direction:column;gap:2px}
    .nav-item{display:flex;align-items:center;gap:10px;padding:9px 10px;border-radius:9px;color:var(--muted);font-size:13.5px}
    .nav-item svg{width:16px;height:16px;flex:none;opacity:.85}
    .nav-item.active{background:rgba(168,85,247,.14);color:var(--text)}
    .nav-item.active svg{color:var(--accent);opacity:1}
    /* Main */
    .main{flex:1;min-width:0;padding:26px 32px 40px}
    .topbar{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:22px}
    h1{margin:0 0 4px;font-size:22px;font-weight:600;letter-spacing:-.01em}
    .topbar p{margin:0;color:var(--muted);font-size:13px}
    .search{display:flex;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:9px 14px;color:var(--muted);font-size:13px;min-width:220px}
    .search svg{width:14px;height:14px;flex:none}
    .section-label{color:var(--muted);font-size:11.5px;letter-spacing:.03em;margin:0 0 10px}
    /* Stat cards */
    .stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:22px}
    .card{background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:18px}
    .card-head{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:11.5px;letter-spacing:.02em;margin-bottom:14px}
    .card-head svg{width:14px;height:14px;opacity:.6}
    .stat-value{font-size:26px;font-weight:700;letter-spacing:-.01em;margin-bottom:4px}
    .stat-sub{color:var(--muted);font-size:12px}
    .stat-sub.up{color:var(--green)}
    .spark{width:100%;height:36px;display:block;margin-top:10px}
    .blob-visual{height:64px;border-radius:8px;background:
    radial-gradient(circle at 30% 40%,rgba(34,211,238,.55),transparent 55%),
    radial-gradient(circle at 65% 60%,rgba(168,85,247,.55),transparent 55%),
    radial-gradient(circle at 50% 20%,rgba(52,211,153,.35),transparent 50%);
    filter:blur(2px);margin-top:6px}
    .wave{width:100%;height:36px;display:block;margin-top:16px}
    /* Filters */
    .filters{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;gap:16px;flex-wrap:wrap}
    .pillrow{display:flex;gap:6px}
    .pill{padding:7px 14px;border-radius:8px;font-size:12.5px;color:var(--muted);border:1px solid transparent;cursor:default}
    .pill.active{background:var(--accent);color:#fff}
    .pill.outline{border-color:var(--border)}
    .count{color:var(--muted);font-size:12.5px;display:flex;align-items:center;gap:6px}
    /* Table */
    .table{width:100%;border-collapse:collapse}
    .table thead th{text-align:left;color:var(--muted);font-weight:500;font-size:11.5px;letter-spacing:.02em;padding:0 12px 10px;border-bottom:1px solid var(--border)}
    .table tbody td{padding:12px;border-bottom:1px solid var(--border);vertical-align:middle}
    .table tbody tr:last-child td{border-bottom:none}
    .table tbody tr.playing{background:rgba(168,85,247,.08)}
    .track{display:flex;align-items:center;gap:12px}
    .cover{width:38px;height:38px;border-radius:8px;flex:none;background:linear-gradient(135deg,var(--accent),var(--accent-2))}
    .track-name{font-weight:600;font-size:13.5px}
    .track-artist{color:var(--muted);font-size:12px;margin-top:1px}
    .genre-tag{display:inline-block;padding:4px 10px;border-radius:6px;background:var(--panel-2);border:1px solid var(--border);color:var(--muted);font-size:11.5px}
    .plays{font-weight:600}
    .plays-sub{color:var(--muted);font-size:11px}
    .now{color:var(--accent);font-weight:600}
    @media (max-width:900px){
    .side{display:none}
    .stats{grid-template-columns:1fr}
    .table thead{display:none}
    .table, .table tbody, .table tbody tr, .table tbody td{display:block;width:100%}
    .table tbody tr{padding:12px 0;border-bottom:1px solid var(--border)}
    .table tbody td{border:none;padding:4px 0}
    }
.app
  aside.side
    .brand
      span.mark &#x25C6;
      | Aether
    nav
      .nav-item
        svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
          circle(cx='12' cy='12' r='9')
        | Discovery
      .nav-item
        svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
          rect(x='4' y='4' width='16' height='16' rx='2')
        | My Library
      .nav-item.active
        svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
          circle(cx='12' cy='12' r='9')
          path(d='M12 7v5l3 2')
        | Listening History
      .nav-item
        svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
          path(d='M4 19V5m8 14V9m8 10V13')
        | Curated Insights
      .nav-item
        svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
          path(d='M12 3v18M3 12h18')
        | Sound Profiles
  main.main
    .topbar
      div
        h1 Listening Archives
        p An editorial catalog of your acoustic journeys, replayed.
      .search
        svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
          circle(cx='11' cy='11' r='7')
          path(d='M21 21l-4.3-4.3')
        |         Search tracks, artists, genres...
    p.section-label MONTH-TO-DATE INSIGHTS
    .stats
      .card
        .card-head
          | ACOUSTIC HOURS 
          svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
            path(d='M12 6v6l4 2')
            circle(cx='12' cy='12' r='9')
        .stat-value 48.5 hrs
        .stat-sub.up +12% more than last week
        svg.spark(viewbox='0 0 200 36' preserveaspectratio='none')
          polyline(points='0,30 20,26 40,28 60,18 80,22 100,12 120,16 140,8 160,14 180,6 200,10' fill='none' stroke='var(--accent)' stroke-width='2')
      .card
        .card-head
          | SONIC CHARACTER 
          svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
            path(d='M4 12h4l3-8 4 16 3-8h2')
        .stat-value(style='color:var(--green)') Atmospheric
        .stat-sub 74% Synthwave &amp; Space Ambient
        .blob-visual
      .card
        .card-head
          | PRIMARY MEDIUM 
          svg(viewbox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2')
            rect(x='3' y='4' width='18' height='14' rx='2')
            path(d='M8 21h8')
        .stat-value Desktop Player
        .stat-sub HQ Audiophile Stream (Lossless)
        svg.wave(viewbox='0 0 200 36' preserveaspectratio='none')
          path(d='M0,18 Q5,4 10,18 T20,18 T30,30 T40,18 T50,6 T60,18 T70,24 T80,18 T90,10 T100,18 T110,26 T120,18 T130,8 T140,18 T150,22 T160,18 T170,12 T180,18 T190,20 T200,18' fill='none' stroke='var(--accent-2)' stroke-width='1.6')
    .filters
      .pillrow
        .pill.outline All-Time
        .pill.active Last 30 Days
        .pill.outline This Week
        .pill.outline Custom Range
      .count &#x21E9; 342 Unique Tracks Listened
    table.table
      thead
        tr
          th Name is no sense
          th ALBUM
          th LAST LISTENED
          th TIMES PLAYED
      tbody
        each track in tracks
          if track.playing
            tr.playing
              td
                .track
                  .cover
                  .track-name= track.title
              td= track.album
              td.now= track.last
              td
                .plays= track.played
                .plays-sub plays
          else
            tr
              td
                .track
                  .cover
                  .track-name= track.title
              td= track.album
              td= track.last
              td
                .plays= track.played
                .plays-sub plays